class Solution {
    public boolean checkIfPangram(String sentence) {
        HashSet<Character> h=new HashSet<>();
        char[] words=sentence.toCharArray();
        for(int i=0;i<words.length;i++){
            if(!h.contains(words[i])){
                h.add(words[i]);
            }
        }
        return h.size()==26;
    }
}
