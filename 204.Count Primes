class Solution {
    public int countPrimes(int n) {
     boolean[] arr=new boolean[n];
     Arrays.fill(arr,true);
     int count=0;
     if(n<=1){
        return count;
     }
     arr[0]=false;arr[1]=false;
      for(int i=2;i*i<=n;i++){
        if(arr[i]==true){
          for(int j=i;i*j<n;j++){
                  arr[i*j]=false;
         }
        }
      }
      for(boolean num:arr){
        if(num==true){
            count++;
        }
      }
    return count;
    }
}
