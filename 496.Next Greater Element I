class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
        for(int i=0;i<nums1.length;i++){
            for(int j=0;j<nums2.length;j++){
                if(nums1[i]==nums2[j]){
                      int k=j+1;
                      boolean found=false;
                    while(k<=nums2.length-1){
                    if(nums2[j]<nums2[k]){
                       nums1[i]=nums2[k];
                        found=true;
                       break;
                    }else{
                        k++;
                    }
                    }
                    if(found!=true){
                        nums1[i]=-1;
                    }
                    break;
                }
               
                
            }

        }
        return nums1;
    }
}
